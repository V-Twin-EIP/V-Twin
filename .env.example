# Optional local launch configuration; contains no secrets.
# Load explicitly: uv run --env-file .env --extra api vtwin serve
VTWIN_HOST=127.0.0.1
VTWIN_PORT=8000
# Workspace for runs (default: per-user data directory outside the repository).
# VTWIN_DATA_DIR=
# Extra loopback dev-frontend origins allowed to call the run API, comma-separated.
# VTWIN_ALLOWED_ORIGINS=http://localhost:5173
VTWIN_RUN_TIMEOUT_S=120
VTWIN_LOG_LEVEL=INFO
VTWIN_LOG_FORMAT=json
# Never put VTWIN_SESSION_TOKEN here: it is generated per launch and must not be stored.
